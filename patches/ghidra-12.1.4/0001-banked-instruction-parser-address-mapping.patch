+package ghidra.program.model.mem;
+
+import java.math.BigInteger;
+
+import ghidra.program.model.address.Address;
+import ghidra.util.GhidraDataConverter;
+
+/**
+ * Opt-in instruction read buffer that keeps high address bits fixed while the
+ * low program-counter bits wrap.  For a 16-bit PC in a 24-bit address space,
+ * bytes at 02:ffff, 02:0000 are read consecutively, not 02:ffff, 03:0000.
+ *
+ * Only suitable for instruction parsing.  The normal disassembler cannot
+ * persist discontinuous code-unit extents using this buffer alone.
+ */
+public final class BankedInstructionMemBuffer implements InstructionAddressMapper {
+	private final Memory memory;
+	private final Address start;
+	private final long pcMask;
+	private final long bankBase;
+	private final GhidraDataConverter converter;
+
+	/**
+	 * @param memory memory containing instruction bytes
+	 * @param start address of the instruction's opcode
+	 * @param pcBits width of the bank-local program counter (16 for 65816)
+	 */
+	public BankedInstructionMemBuffer(Memory memory, Address start, int pcBits) {
+		if (pcBits < 1 || pcBits > 30) {
+			throw new IllegalArgumentException("PC width must be between 1 and 30 bits");
+		}
+		if (pcBits >= start.getAddressSpace().getSize()) {
+			throw new IllegalArgumentException("PC width must be smaller than address width");
+		}
+		this.memory = memory;
+		this.start = start;
+		this.pcMask = (1L << pcBits) - 1;
+		this.bankBase = start.getOffset() & ~pcMask;
+		this.converter = GhidraDataConverter.getInstance(memory.isBigEndian());
+	}
+
+	@Override
+	public Address getInstructionAddress(int byteOffset) {
+		long pc = (start.getOffset() + byteOffset) & pcMask;
+		return start.getAddressSpace().getAddress(bankBase | pc);
+	}
+
+	@Override
+	public byte getByte(int offset) throws MemoryAccessException {
+		return memory.getByte(getInstructionAddress(offset));
+	}
+
+	@Override
+	public int getBytes(byte[] result, int offset) {
+		int read = 0;
+		for (; read < result.length; read++) {
+			try {
+				result[read] = getByte(offset + read);
+			}
+			catch (MemoryAccessException e) {
+				break;
+			}
+		}
+		return read;
+	}
+
+	@Override
+	public Address getAddress() {
+		return start;
+	}
+
+	@Override
+	public Memory getMemory() {
+		return memory;
+	}
+
+	@Override
+	public boolean isBigEndian() {
+		return memory.isBigEndian();
+	}
+
+	@Override
+	public short getShort(int offset) throws MemoryAccessException {
+		return converter.getShort(this, offset);
+	}
+
+	@Override
+	public int getInt(int offset) throws MemoryAccessException {
+		return converter.getInt(this, offset);
+	}
+
+	@Override
+	public long getLong(int offset) throws MemoryAccessException {
+		return converter.getLong(this, offset);
+	}
+
+	@Override
+	public BigInteger getBigInteger(int offset, int size, boolean signed)
+			throws MemoryAccessException {
+		return converter.getBigInteger(this, offset, size, signed);
+	}
+}
