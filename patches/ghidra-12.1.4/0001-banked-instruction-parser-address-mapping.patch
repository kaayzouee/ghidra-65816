+package ghidra.program.model.mem;
+
+import ghidra.program.model.address.Address;
+
+/**
+ * Optional instruction-byte address mapping for parser buffers.  An implementation
+ * must map an instruction-relative offset to the address from which that byte is
+ * fetched.  The same mapping is used when calculating inst_next and the prototype
+ * fall-through.  Standard MemBuffer implementations remain unchanged.
+ *
+ * This interface does not change Ghidra's persistent code-unit extent model.
+ */
+public interface InstructionAddressMapper extends MemBuffer {
+
+	/**
+	 * @param byteOffset displacement from the start of the instruction
+	 * @return address of that instruction byte, or null when unavailable
+	 */
+	Address getInstructionAddress(int byteOffset);
+}
